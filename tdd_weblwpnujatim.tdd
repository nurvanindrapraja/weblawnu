# 2. ERD / ENTITY RELATIONSHIP DIAGRAM

ERD utama:

```mermaid
erDiagram

    USERS {
        bigint id PK
        varchar name
        varchar username UK
        varchar email UK
        varchar phone
        varchar password
        varchar avatar
        enum status
        datetime last_login_at
        timestamps created_at
        timestamps updated_at
    }

    ROLES {
        bigint id PK
        varchar name UK
        varchar display_name
        text description
        timestamps created_at
        timestamps updated_at
    }

    PERMISSIONS {
        bigint id PK
        varchar name UK
        varchar display_name
        text description
        timestamps created_at
        timestamps updated_at
    }

    ROLE_USER {
        bigint role_id FK
        bigint user_id FK
    }

    PERMISSION_ROLE {
        bigint permission_id FK
        bigint role_id FK
    }

    MENUS {
        bigint id PK
        bigint parent_id FK
        varchar title
        varchar type
        varchar url
        varchar target
        varchar icon
        int sort_order
        boolean is_active
        timestamps created_at
        timestamps updated_at
    }

    PAGES {
        bigint id PK
        bigint author_id FK
        varchar title
        varchar slug UK
        text excerpt
        longtext content
        bigint featured_media_id FK
        enum status
        varchar meta_title
        text meta_description
        datetime published_at
        timestamps created_at
        timestamps updated_at
    }

    CATEGORIES {
        bigint id PK
        bigint parent_id FK
        varchar name
        varchar slug UK
        text description
        boolean is_active
        timestamps created_at
        timestamps updated_at
    }

    TAGS {
        bigint id PK
        varchar name
        varchar slug UK
        timestamps created_at
        timestamps updated_at
    }

    POSTS {
        bigint id PK
        bigint author_id FK
        bigint category_id FK
        bigint featured_media_id FK
        varchar title
        varchar slug UK
        text excerpt
        longtext content
        enum status
        text rejection_note
        datetime submitted_at
        datetime reviewed_at
        datetime published_at
        bigint reviewed_by FK
        bigint published_by FK
        bigint views
        decimal rating_average
        bigint rating_count
        varchar meta_title
        text meta_description
        timestamps created_at
        timestamps updated_at
    }

    POST_TAG {
        bigint post_id FK
        bigint tag_id FK
    }

    MEDIA {
        bigint id PK
        bigint uploaded_by FK
        varchar filename
        varchar original_name
        varchar disk
        varchar path
        varchar mime_type
        bigint size
        int width
        int height
        text alt_text
        text caption
        timestamps created_at
        timestamps updated_at
    }

    POST_MEDIA {
        bigint post_id FK
        bigint media_id FK
        int sort_order
    }

    RATINGS {
        bigint id PK
        bigint post_id FK
        tinyint rating
        varchar visitor_hash
        varchar session_hash
        timestamps created_at
        timestamps updated_at
    }

    CONTACT_MESSAGES {
        bigint id PK
        varchar name
        varchar email
        varchar phone
        varchar subject
        text message
        enum status
        text admin_note
        bigint handled_by FK
        datetime handled_at
        timestamps created_at
        timestamps updated_at
    }

    ACTIVITY_LOGS {
        bigint id PK
        bigint user_id FK
        varchar module
        varchar action
        bigint record_id
        text description
        varchar ip_hash
        varchar user_agent
        timestamps created_at
    }

    SETTINGS {
        bigint id PK
        varchar key UK
        text value
        varchar type
        varchar group_name
        timestamps created_at
        timestamps updated_at
    }

    USERS ||--o{ PAGES : creates
    USERS ||--o{ POSTS : writes
    USERS ||--o{ POSTS : reviews
    USERS ||--o{ POSTS : publishes
    USERS ||--o{ MEDIA : uploads
    USERS ||--o{ CONTACT_MESSAGES : handles
    USERS ||--o{ ACTIVITY_LOGS : creates

    ROLES ||--o{ ROLE_USER : has
    USERS ||--o{ ROLE_USER : assigned

    ROLES ||--o{ PERMISSION_ROLE : grants
    PERMISSIONS ||--o{ PERMISSION_ROLE : contains

    MENUS ||--o{ MENUS : parent

    CATEGORIES ||--o{ CATEGORIES : parent
    CATEGORIES ||--o{ POSTS : contains

    POSTS ||--o{ POST_TAG : has
    TAGS ||--o{ POST_TAG : assigned

    POSTS ||--o{ POST_MEDIA : contains
    MEDIA ||--o{ POST_MEDIA : attached

    POSTS ||--o{ RATINGS : receives

    MEDIA ||--o{ PAGES : featured
    MEDIA ||--o{ POSTS : featured
```

